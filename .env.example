# Postgres hospedado (Neon, Supabase, Vercel Postgres…). Obrigatório.
DATABASE_URL="postgresql://usuario:senha@host:5432/visaoderua?sslmode=require"

# Access token do Mercado Pago (Credenciais > Produção ou Teste).
